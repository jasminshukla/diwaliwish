# Build-time fallbacks. Production prefers the Wrangler vars of the same meaning,
# which the site reads at runtime from GET /api/config.
# Never put secrets in this file. Secrets belong in .dev.vars or `wrangler secret put`.

# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Cloudflare Turnstile site key. Local testing can use the always-pass dummy key:
# 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional Cloudflare Web Analytics beacon token (public token, not an API token).
VITE_CF_BEACON_TOKEN=
