{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "happy-diwali-2026",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "DATA_RETENTION_DAYS": "365",
    "GA_MEASUREMENT_ID": "",
    "TURNSTILE_SITE_KEY": "",
    "CF_BEACON_TOKEN": "",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "GA4_PROPERTY_ID": "",
    "GA4_CLIENT_EMAIL": "",
    "SITE_CONTACT_EMAIL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diwali_wishes_db",
      // Replace this after `npx wrangler d1 create diwali_wishes_db`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["15 3 * * *"]
  }
}
